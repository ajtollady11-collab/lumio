# ─────────────────────────────────────────────────────────────────────────────
# Lumio environment variables
# Copy to .env.local for development. In Vercel, set these per environment
# (Production / Preview / Development) under Project → Settings → Environment Variables.
#
# NEXT_PUBLIC_* values are embedded in browser JavaScript. Never put a secret
# in a NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute origin used to build auth email links. Production: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1 — required) ────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses Row Level Security. REQUIRED for the AI tutor: the
# server (never the browser) saves tutor replies, usage and memory with it, so
# students can't forge them. Supabase Dashboard → Project Settings → API Keys →
# "Secret keys" → create/copy (starts with sb_secret_). Free plan is fine.
SUPABASE_SECRET_KEY=
# Set to true once Google is enabled under Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# ── AI providers (server-only) ───────────────────────────────────────────────
# REQUIRED for the AI tutor. console.anthropic.com → API Keys → Create Key
# (starts with sk-ant-). Add a monthly spend limit under Billing → Limits.
# Without this (or SUPABASE_SECRET_KEY) the tutor page shows a setup message
# naming the missing variable; the rest of Lumio works normally.
ANTHROPIC_API_KEY=
# Not used yet — reserved for a second provider.
OPENAI_API_KEY=

# ── Stripe (Phase 7 — server-only) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
