# ─────────────────────────────────────────────────────────────────────────────
# Lumio environment variables
# Copy to .env.local for development. In Vercel, set these per environment
# (Production / Preview / Development) under Project → Settings → Environment Variables.
#
# NEXT_PUBLIC_* values are embedded in browser JavaScript. Never put a secret
# in a NEXT_PUBLIC_* variable.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ─────────────────────────────────────────────────────────────────────
# Absolute origin used to build auth email links. Production: https://<your-domain>
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Supabase (Phase 1 — required) ────────────────────────────────────────────
# Supabase Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server-only. Bypasses Row Level Security. Needed from Phase 2 (account linking)
# onward. Supabase Dashboard → Project Settings → API Keys → Secret keys.
SUPABASE_SECRET_KEY=
# Set to true once Google is enabled under Supabase → Authentication → Providers.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# ── AI providers (Phase 3 — server-only) ─────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Stripe (Phase 7 — server-only) ───────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
